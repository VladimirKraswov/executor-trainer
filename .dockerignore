# Whitelist approach for .dockerignore
# 1. Ignore everything
**

# 2. Allow only necessary files and folders
!requirements.txt
!requirements.vllm.txt
!packages/
!app/
!docker/
!docker/entrypoint.sh
!docker/install_with_local_wheels.sh

# 3. Explicitly ignore sensitive/temporary files within allowed folders
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/*.log
**/*.tmp
app/tests/
